{
  "name": "@endeavor/web",
  "version": "0.1.0",
  "private": true,
  "description": "Endeavor: The web interface (Svelte 5 and Vite). The API serves its build at /app/.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint \"src/**/*.{ts,svelte}\" \"e2e/**/*.{ts,mjs}\" playwright.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.e2e.json",
    "test": "node --conditions=browser --test src/*.test.ts",
    "test:e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.5"
  }
}
