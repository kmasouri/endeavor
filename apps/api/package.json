{
  "name": "@endeavor/api",
  "version": "0.1.0",
  "private": true,
  "description": "Endeavor: The platform's API, runner, and scheduler (Fastify and TypeScript).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ENVIRONMENT=local tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "ENVIRONMENT=test LOGGER_LEVEL=silent NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "ENVIRONMENT=test LOGGER_LEVEL=silent NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "ENVIRONMENT=test LOGGER_LEVEL=silent NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "ENVIRONMENT=local tsx src/migrate.ts",
    "routing:eval": "ENVIRONMENT=local LOGGER_LEVEL=silent tsx --env-file-if-exists=../../.env src/routing-eval.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.87",
    "@ai-sdk/openai": "4.0.101",
    "@fastify/postgres": "^6.1.0",
    "@fastify/request-context": "^7.0.0",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-zod": "^1.0.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "ai": "7.0.151",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "clearMocks": true,
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
