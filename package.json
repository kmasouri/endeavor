{
  "name": "bold-cedar-007",
  "version": "0.1.0",
  "private": true,
  "description": "Layered Fastify/TypeScript service.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ENVIRONMENT=local tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.mts",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "vite build --config web/vite.config.mts",
    "start": "node dist/index.js",
    "test": "ENVIRONMENT=test LOGGER_LEVEL=silent NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "ENVIRONMENT=test LOGGER_LEVEL=silent NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "ENVIRONMENT=test LOGGER_LEVEL=silent NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f app",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "ENVIRONMENT=local tsx src/migrate.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fastify/postgres": "^6.1.0",
    "@fastify/request-context": "^7.0.0",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-zod": "^1.0.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.5"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 100
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "clearMocks": true,
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
