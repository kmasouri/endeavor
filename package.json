{
  "name": "bold-cedar-007",
  "version": "0.1.0",
  "private": true,
  "description": "Collaborative Agents: the API (apps/api) and the web interface (apps/web).",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces",
    "start": "npm start -w apps/api",
    "test": "npm test --workspaces --if-present && node --test 'pilot/*.test.ts'",
    "test:coverage": "npm run test:coverage -w apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "typecheck": "npm run typecheck --workspaces && tsc -p pilot/tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f app",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w apps/api",
    "pilot:api": "docker compose --profile pilot up -d pilot-api",
    "pilot:setup": "node --env-file-if-exists=.env pilot/setup.ts",
    "pilot:brief": "node pilot/brief.ts",
    "pilot:report": "node pilot/report.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 100
  }
}
