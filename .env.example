ENVIRONMENT=local
# .env is loaded only when ENVIRONMENT=local.
# Keep 127.0.0.1 locally: the API trusts x-actor-id until real sign-in exists.
HOST=127.0.0.1
PORT=3000
# With Docker (npm run up), the port on this computer. Change it if 3000 is taken.
# APP_PORT=3000
# With Docker, the database's port on this computer. Change it if 5432 is taken, and match
# DATABASE_PORT (or DATABASE_URL) for npm run dev.
# DB_PORT=5432
# Use either DATABASE_URL or the discrete DATABASE_* settings below.
# DATABASE_URL=postgres://user:password@postgres-host:5432/endeavor
DATABASE_HOST=localhost
DATABASE_PORT=5432
# For an existing installation, migrate the database first; see docs/rebranding.md.
DATABASE_NAME=endeavor
DATABASE_USER=endeavor
DATABASE_PASSWORD=endeavor
LOGGER_LEVEL=info
REQUEST_ID_HEADER=x-request-id
# Where to send events like item.created. Leave unset to turn webhooks off.
# WEBHOOK_URL=https://example.com/hooks
# Model providers. Agents on a provider only run when its key is set. Tools run on this
# computer, but the models are called over the internet.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OpenAI is called through its Responses API. Point this at a compatible API that supports it.
# OPENAI_BASE_URL=https://api.openai.com/v1
# The runner delivers messages and runs agents' work while the server is up.
RUNNER_ENABLED=true
RUNNER_INTERVAL_MS=2000
# Deadline for one model request, including completion checks (1–3600000 ms).
MODEL_TIMEOUT_MS=120000
# Set to true to check each result against its criteria with a separate model call before a
# task completes. It costs one small extra call per finished task. Off by default.
COMPLETION_CHECK=false
# Model prices in US dollars per million tokens, so costs and dollar budgets work. Check your
# provider's price page. Models not listed have an unknown cost.
# MODEL_PRICES={"your-model":{"inputPerMillion":0.15,"outputPerMillion":0.6}}
# The most one task may spend, in US dollars, unless its agent sets its own limit.
TASK_BUDGET_USD=1
# Where agents' files go, one folder per task. Nothing outside a task's folder can be touched.
WORKSPACES_DIR=workspaces
# Encrypts connection credentials. Make one with: openssl rand -base64 32
# CREDENTIALS_KEY=

# Public browser origin for OAuth callbacks. Match the address used to open the app.
# APP_PUBLIC_URL=http://localhost:3100

# Optional coding execution service; see docs/coding.md and compose.coding.yml.
# EXECUTOR_HOST=0.0.0.0
# EXECUTOR_PORT=3200
# EXECUTOR_TOKEN=  # at least 32 random characters; openssl rand -hex 32
# EXECUTOR_IMAGE=endeavor-sandbox:local
# EXECUTOR_DATA_DIR=/data
# Comma-separated repositories the broker may fetch. Empty permits none.
# EXECUTOR_REPOSITORIES=owner/repository
# Optional read-only GitHub token for private repository snapshots. Never sent to a sandbox.
# EXECUTOR_GITHUB_TOKEN=

# Decision model used for untagged requests and missing handoffs.
ROUTING_MODEL=gpt-6-luna
