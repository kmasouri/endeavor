# New stacks only. Existing stacks must keep their current project_name and image URI.
project_name            = "endeavor"
aws_region              = "us-east-1"
environment             = "sandbox"
github_repository       = "kmasouri/endeavor"
service_container_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/endeavor-sandbox-service:latest"

service_environment_variables = {
  ENVIRONMENT = "production"
  HOST        = "0.0.0.0"
  PORT        = "3000"
}
